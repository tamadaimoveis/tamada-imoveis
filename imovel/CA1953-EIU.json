 (já inclusos na negociação).\r\n\r\n*Possibilidade de negociação:*\r\n- Móveis não planejados podem ser negociados à parte.\r\n\r\nAproveite essa chance Única de adquirir um imóvel completo, com tudo o que você e sua família merecem! Agende sua visita e venha conferir pessoalmente essa excelente opção no Parque Boturussu.","comodidades":["Churrasqueira","Quintal","Lavabo","Área de Serviço","Escritório","Portão Eletrônico","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Casa Residencial","finalidade":"residencial","areaUtil":90,"areaTotal":137,"quartos":2,"suites":null,"banheiros":2,"salas":1,"vagas":2,"vagasCobertas":2,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2015,"anoReforma":null,"condominio":null,"iptu":null,"precoM2":7111.11,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":null,"locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}