her e mercado, todas as quartas no período noturno com diversas barracas de feira.\r\n\r\nPróximo ao terminal de ônibus da Vila Carrão, Atacadão, Carrefour, Assaí, fácil acesso pela Avenida Conselheiro Carrão e Avenida Aricanduva.\r\n\r\nIPTU R$140,00 ao ano / Estuda carro no valor de revenda como parte de pagamento.\r\n\r\nAceita financiamento !\r\n\r\nAgende uma visita com um dos nossos corretores !!","comodidades":["Piscina","Churrasqueira","Sacada / Varanda","Quintal","Área de Serviço","Vestiário","Interfone","Portão Eletrônico","Aceita Pet","Condomínio Fechado","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Apartamento de Condomínio","finalidade":"residencial","areaUtil":76,"areaTotal":null,"quartos":3,"suites":1,"banheiros":1,"salas":2,"vagas":1,"vagasCobertas":null,"vagasDescobertas":1,"tipoVaga":null,"andar":7,"andaresPredio":10,"elevadores":null,"peDireito":null,"anoConstrucao":2000,"anoReforma":2020,"condominio":650,"iptu":120,"precoM2":8092.11,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":null,"locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Sandro","celular":"(11) 96204-1814","creci":null}}