os mais aconchegantes.\r\n\r\nContendo:\r\n2 DORMITORIOS sendo 1 SUITES 1 BANHEIRO 1 LAVABO\r\n\r\n2 SACADAS\r\n3 VAGAS GARAGEM SENDO 2 COBERTAS\r\n250 M2\r\nSALA, LAVABO E COZINHA AMPLA EM PORCELANATO DECORADO\r\nVIDROS VERDES TEMPERADOS NA SALA, COZINHA E SACADA\r\nESCADAS E PIAS COM GABINETE EM GRANITO\r\nCERCA ELETRICA\r\nAZULEJO DECORADO COZINHA E BANHEIROS\r\nLAVANDERIA COBERTA COM VIDRO TEMPERADO BRANCO\r\nCHURRASQUEIRA COMPLETA\r\n\r\n- 03 minutos até o Metrô Vila Matilde\r\n- 05 minutos até o Metrô Guilhermina Esperança\r\n- 08 minutos até o Shopping Penha!\r\n- 02 minutos andando até o ponto de Ônibus mais próximo!!","comodidades":["Churrasqueira","Sacada / Varanda","Quintal","Lavabo","Área de Serviço","Interfone","Portão Eletrônico","Aceita Pet","Água","Esgoto","Energia Elétrica","Garagem Coberta","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato","Cerâmica"],"garantias":["Caução","Seguro Fiança"],"pagamento":[],"tags":["Alto Padrão"],"ficha":{"subTipo":"Sobrado Residencial","finalidade":"residencial","areaUtil":75,"areaTotal":180,"quartos":2,"suites":null,"banheiros":3,"salas":1,"vagas":3,"vagasCobertas":3,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":3,"elevadores":null,"peDireito":null,"anoConstrucao":2014,"anoReforma":null,"condominio":null,"iptu":165,"precoM2":null,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Desocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}