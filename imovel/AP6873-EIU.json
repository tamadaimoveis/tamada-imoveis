ado com elevador, garantindo acessibilidade e facilitando o transporte de moradores e visitantes entre os andares. \r\n\r\nA vaga de garagem é coberta, pé direito alto e portão automático, localizada no subsolo, oferecendo maior proteção ao veículo e mais comodidade aos moradores.\r\n\r\nAceita financiamento.","comodidades":["Interfone","Aceita Pet"],"acabamentos":["Porcelanato"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Apartamento Residencial","finalidade":"residencial","areaUtil":43,"areaTotal":null,"quartos":2,"suites":null,"banheiros":1,"salas":1,"vagas":null,"vagasCobertas":null,"vagasDescobertas":null,"tipoVaga":null,"andar":3,"andaresPredio":6,"elevadores":null,"peDireito":null,"anoConstrucao":2024,"anoReforma":null,"condominio":250,"iptu":null,"precoM2":6511.63,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":null,"locado":null,"exclusividade":false,"zoneamento":"ZC","obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}