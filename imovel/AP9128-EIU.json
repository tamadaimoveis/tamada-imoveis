ente incidência de luz natural durante a manhã e a tarde. \r\n\r\nConta com armários planejados e ambientes bem distribuídos, oferecendo muito conforto para toda a família.\r\n\r\nCaracterísticas do imóvel: 2 quartos, banheiro social e lavabo, sala para 2 ambientes com sacada, cozinha com armários planejados, área de serviço.\r\n\r\nEspaço gourmet privativo com churrasqueira ecológica e 1 vaga de garagem.\r\n\r\nO apartamento está localizado em um prédio tranquilo de apenas 4 andares, com 2 apartamentos por andar, elevador e ambiente residencial, ideal para quem valoriza privacidade e sossego.\r\n\r\nO condomínio não possui área de lazer, o que contribui para um custo condominial mais acessível.\r\n\r\nAceita financiamento bancário e uso de FGTS.\r\n\r\nAgende sua visita com um dos nossos corretores!","comodidades":["Churrasqueira","Sacada / Varanda","Quintal","Lavabo","Área de Serviço","Interfone","Portão Eletrônico","TV a Cabo","Aceita Pet","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato","Cerâmica","Granito"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Apartamento Residencial","finalidade":"residencial","areaUtil":75,"areaTotal":null,"quartos":2,"suites":null,"banheiros":1,"salas":1,"vagas":1,"vagasCobertas":1,"vagasDescobertas":null,"tipoVaga":null,"andar":3,"andaresPredio":4,"elevadores":null,"peDireito":null,"anoConstrucao":2024,"anoReforma":null,"condominio":320,"iptu":90,"precoM2":8933.33,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Solange","celular":"(11) 98415-6556","creci":null}}