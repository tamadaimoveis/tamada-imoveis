 com um de nossos corretores !!","comodidades":["Sacada / Varanda","Lavabo","Área de Serviço","Portão Eletrônico","Aceita Pet","Água","Esgoto","Energia Elétrica","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Casa Residencial","finalidade":"residencial","areaUtil":185,"areaTotal":null,"quartos":3,"suites":1,"banheiros":2,"salas":1,"vagas":4,"vagasCobertas":4,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2000,"anoReforma":null,"condominio":null,"iptu":300,"precoM2":5398.38,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Desocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":null,"videoInstitucional":false,"tour":null,"corretor":{"nome":"Alberto Kahakami","celular":"(11) 95000-3956","creci":null}}