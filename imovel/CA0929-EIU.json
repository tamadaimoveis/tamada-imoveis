ranquila. \r\n\r\nA Tamada Imóveis é sinônimo de segurança, conforto e confiabilidade em todas as etapas de seu negócio.","comodidades":["Quintal","Lavabo","Área de Serviço","Interfone","Água","Esgoto","Energia Elétrica","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Casa Residencial","finalidade":"residencial","areaUtil":110,"areaTotal":129,"quartos":3,"suites":1,"banheiros":2,"salas":1,"vagas":2,"vagasCobertas":2,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":1990,"anoReforma":null,"condominio":null,"iptu":null,"precoM2":3909.09,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":"Ocupado","locado":true,"exclusividade":false,"zoneamento":"ZM","obra":null},"video":null,"videoInstitucional":false,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}