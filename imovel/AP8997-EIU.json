forto em um só lugar.\r\n\r\nA proximidade com Escola Estadual Professor Palace Marques, Escola Municipal de Educação Fundamental Luís, Praça Nossa Senhora de Fátima, Estrela Baby Escola de Educação Infantil, Pre Escola Recanto do Pica Pau e Escola República do Uruguai acrescenta praticidade e comodidade na rotina dos que residem no local.\r\n\r\nPróximo a comércio e serviços, com acesso às principais vias da região e metrô.\r\n\r\n* Estuda permuta por sobrado em condomínio ate R$ 530 mil, \r\n3 quartos, 1 vaga de garagem.\r\n\r\nAceita financiamento !\r\n\r\nAgende uma visita com um de nossos corretores !!","comodidades":["Piscina","Lavabo","Área de Serviço","Interfone","Portão Eletrônico","TV a Cabo","Aceita Pet","Garagem Coberta","Armários Planejados"],"acabamentos":["Porcelanato"],"garantias":[],"pagamento":["Financiamento bancário","Permuta"],"tags":[],"ficha":{"subTipo":"Apartamento Residencial","finalidade":"residencial","areaUtil":56,"areaTotal":56,"quartos":2,"suites":null,"banheiros":1,"salas":1,"vagas":1,"vagasCobertas":1,"vagasDescobertas":null,"tipoVaga":null,"andar":2,"andaresPredio":13,"elevadores":null,"peDireito":null,"anoConstrucao":2000,"anoReforma":null,"condominio":699,"iptu":null,"precoM2":5357.14,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Claudio Domingues","celular":"(11) 97795-5441","creci":null}}