imo a pontos de interesse de Jardim Flor da Montanha, tais como Parque Shopping Maia, Escola Carlos Julieta, E.P.G. Dolores Gilabel Hernandes Pompeo, Colégio Klaxon, Zoológico Municipal de Guarulhos e UBS Continental.\r\n\r\ncondomínio oferece: Brinquedoteca, Churrasqueira(s) coletiva(s), Elevador(es), Espaço gourmet, Piscina, Playground, Portão eletrônico, Portaria 24h, Quadra de esporte, Salão de festas, Salão de jogos, Vaga(s) para visitantes, Bicicletário, Elevador(es) de serviço, Piscina aquecida, Academia, Salão multiuso, Área para pets, Interfone, Jardim, Hall de entrada decorado, Sistema de câmeras, Aceita animais.","comodidades":["Piscina","Churrasqueira","Quadra Poliesportiva","Campo de Futebol","Sacada / Varanda","Varanda Gourmet","Lavabo","Área de Serviço","Copa","Despensa","Escritório","Closet","Lareira","Dormitório Reversível","Dormitório de Empregada","Ar Condicionado","Interfone","Portão Eletrônico","TV a Cabo","Mobiliado","Aceita Pet","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato","Laminado"],"garantias":[],"pagamento":["Financiamento bancário","Permuta"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Apartamento Residencial","finalidade":"residencial","areaUtil":122,"areaTotal":122,"quartos":3,"suites":3,"banheiros":5,"salas":2,"vagas":2,"vagasCobertas":2,"vagasDescobertas":null,"tipoVaga":null,"andar":6,"andaresPredio":25,"elevadores":null,"peDireito":null,"anoConstrucao":2019,"anoReforma":null,"condominio":1200,"iptu":245,"precoM2":11065.57,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":null,"videoInstitucional":false,"tour":null,"corretor":{"nome":"Claudio Domingues","celular":"(11) 97795-5441","creci":null}}