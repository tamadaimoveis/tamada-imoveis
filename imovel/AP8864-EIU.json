 pia e armário embutido, porta embutida na parede do banheiro. Iluminação em led e teto de gesso por todo o apartamento.\r\n\r\nCondomínio tranquilo com área verde e salão de festas, espaço gourmet com churrasqueira e forno de pizza, academia, brinquedoteca, bicicletário, salão de jogos, playground, mini mercado e portaria 24 horas, sistema se segurança com câmeras de monitoramento em todo condomínio, entrada exclusiva de morados com identificação facial.\r\n\r\nAceita financiamento !\r\n\r\nAgende uma visita com um dos nossos corretores !!","comodidades":["Churrasqueira","Quadra Poliesportiva","Sacada / Varanda","Área de Serviço","Dormitório Reversível","Interfone","Portão Eletrônico","Aceita Pet","Condomínio Fechado","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato","Laminado"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Apartamento de Condomínio","finalidade":"residencial","areaUtil":71,"areaTotal":null,"quartos":2,"suites":null,"banheiros":1,"salas":2,"vagas":1,"vagasCobertas":1,"vagasDescobertas":null,"tipoVaga":null,"andar":8,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2003,"anoReforma":null,"condominio":529,"iptu":null,"precoM2":6056.34,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":null,"locado":true,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Marcio","celular":"(11) 94022-9631","creci":null}}