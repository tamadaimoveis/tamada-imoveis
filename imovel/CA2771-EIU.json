a851534c-1024x768.jpg"],"descricao":"Sobrado 3 Quartos 1 Suíte Sala Cozinha 3 Banheiros 5 Vagas de Garagem.\r\nCorredor Lateral Piscina com Aquecimento Central. ao lado tem um Espaço para os cachorros.\r\nBox\r\nVaranda\r\nArmários nos banheiros\r\nArmários na cozinha\r\nQuintal\r\nSomente uma casa no terreno\r\nÁrea de serviço\r\nEsta espaçosa casa com 3 quartos e 3 banheiros é uma excelente oportunidade para quem busca conforto e qualidade de vida. Localizada em uma área privilegiada, a residência conta com uma suíte, oferecendo mais privacidade e comodidade para os moradores. A varanda é um convite ao relaxamento, perfeita para desfrutar de momentos tranquilos ao ar livre. O quintal com amplo espaço proporciona diversas possibilidades de lazer e entretenimento. Os três banheiros atendem perfeitamente às necessidades de uma família, garantindo praticidade e funcionalidade no dia a dia. Com sua distribuição inteligente e design moderno, esta casa é ideal para quem valoriza um ambiente aconchegante e bem planejado. Não perca a chance de conhecer e se encantar com tudo o que esta propriedade tem a oferecer.","comodidades":["Piscina","Quintal","Lavabo","Área de Serviço","Portão Eletrônico","Água","Esgoto","Energia Elétrica","Rua Asfaltada","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Casa Residencial","finalidade":"residencial","areaUtil":134,"areaTotal":186,"quartos":3,"suites":1,"banheiros":3,"salas":1,"vagas":4,"vagasCobertas":4,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2010,"anoReforma":null,"condominio":null,"iptu":146.66,"precoM2":8208.96,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":null,"videoInstitucional":false,"tour":null,"corretor":{