r\n\r\nA proximidade com Escola Municipal, Colégio Olivetano, Estação Vila Matilde, Escola Estadual João Maria Ogno, Uno par e Hospital Santa Clara acrescenta praticidade e comodidade na rotina dos que residem no local.","comodidades":["Piscina","Churrasqueira","Quadra Poliesportiva","Sacada / Varanda","Varanda Gourmet","Área de Serviço","Ar Condicionado","Interfone","Portão Eletrônico","Alarme","Aceita Pet","Garagem Coberta","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Apartamento Residencial","finalidade":"residencial","areaUtil":66,"areaTotal":null,"quartos":3,"suites":1,"banheiros":2,"salas":1,"vagas":2,"vagasCobertas":2,"vagasDescobertas":null,"tipoVaga":null,"andar":111,"andaresPredio":20,"elevadores":null,"peDireito":null,"anoConstrucao":2024,"anoReforma":null,"condominio":850,"iptu":null,"precoM2":11363.64,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":null,"videoInstitucional":false,"tour":null,"corretor":{"nome":"Camara","celular":"(11) 97709-4147","creci":null}}