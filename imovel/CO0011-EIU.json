de de qualidade.\r\n\r\nAs opções de compras são abundantes, com diversos shoppings, lojas e mercados nas proximidades, garantindo conveniência para compras do dia a dia e lazer.\r\n\r\nPara os amantes da gastronomia, o bairro oferece uma ampla variedade de restaurantes, cafés e bares que atendem a todos os gostos e preferências, desde culinária local até opções internacionais.\r\n\r\nAlém disso, a presença de parques e áreas verdes nas proximidades oferece espaços ideais para atividades ao ar livre, exercícios físicos e momentos de relaxamento em meio à natureza.\r\n\r\nAcesso fácil a transporte público, como ônibus e estações de metrô, permite deslocamentos rápidos e eficientes pela cidade, conectando os moradores a outras áreas de São Paulo.\r\n\r\nAceita Financiamento!\r\n\r\nG: AGENDE SUA VISITA! -","comodidades":["Piscina","Churrasqueira","Hidromassagem","Sacada / Varanda","Quintal","Lavabo","Área de Serviço","Despensa","Escritório","Closet","Dormitório de Empregada","WC de Empregada","Ar Condicionado","Interfone","Portão Eletrônico","TV a Cabo","Zelador","Aceita Pet","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato","Cerâmica"],"garantias":[],"pagamento":["Financiamento bancário","Permuta"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Cobertura Residencial","finalidade":"residencial","areaUtil":624,"areaTotal":null,"quartos":4,"suites":2,"banheiros":3,"salas":3,"vagas":3,"vagasCobertas":3,"vagasDescobertas":null,"tipoVaga":null,"andar":18,"andaresPredio":18,"elevadores":null,"peDireito":null,"anoConstrucao":2015,"anoReforma":null,"condominio":4500,"iptu":2000,"precoM2":5288.46,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Victor","celular":"(11) 98500-1913","creci":null}}