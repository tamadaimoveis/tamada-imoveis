ros. \r\n\r\n- Refeitório. \r\n\r\n- Vestiário masculino e feminino. \r\n\r\n- Sala externa de reuniões. \r\n\r\n- Estacionamento para 10 veículos. \r\n\r\n- Entrada para carreta. \r\n\r\n- Pé direito alto: 7 metros; altura da porta de enrolar: 6 metros. \r\n\r\n- Zoneamento ZC. \r\n\r\nLocalização privilegiada: \r\n\r\n- Próximo às principais vias de escoamento de São Paulo. \r\n\r\n- Às marginais Tietê e Radial Leste. \r\n\r\n- A apenas 6 minutos da futura estação Metrô Tiquatira. \r\n\r\n- A 7 minutos da Estação CPTM Engenheiro Goulart. \r\n\r\nAceita-se incorporação no local.\r\n\r\nImóvel locado.\r\n\r\nDocumentação em ordem.","comodidades":["Copa","Escritório","Vestiário","Interfone","Portão Eletrônico","Alarme","Água","Esgoto","Energia Elétrica","Rua Asfaltada","Entrada para Caminhões","Doca","Casa de Caseiro","Garagem Coberta","Cozinha com Área de Serviço"],"acabamentos":[],"garantias":[],"pagamento":["Financiamento bancário","Permuta"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Galpão Comercial","finalidade":"comercial","areaUtil":1800,"areaTotal":2450,"quartos":null,"suites":null,"banheiros":3,"salas":2,"vagas":14,"vagasCobertas":4,"vagasDescobertas":10,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":900,"anoConstrucao":1995,"anoReforma":null,"condominio":null,"iptu":5100,"precoM2":5944.44,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":"Desocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":null,"videoInstitucional":false,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}