s dias de semana e eventualmente finais de semana se contratado a parte.\r\nPróximo de tudo o que precisa para o seu dia-a-dia, estando apenas a 800m do metrô Vila Prudente, a 6 minutos do Mooca Plaza Shopping, a 900m do Clube Juventus e a 4 minutos do parque da Mooca e Parque da Sabesp. Tenha fácil acesso as principais vias da região, como a Avenida Presidente Wilson e Avenida Anhaia Mello.","comodidades":["Piscina","Churrasqueira","Sauna","Quadra Poliesportiva","Sacada / Varanda","Área de Serviço","Ar Condicionado","Interfone","Aceita Pet","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":[],"tags":[],"ficha":{"subTipo":"Apartamento Residencial","finalidade":"residencial","areaUtil":75,"areaTotal":null,"quartos":2,"suites":1,"banheiros":2,"salas":1,"vagas":1,"vagasCobertas":1,"vagasDescobertas":null,"tipoVaga":null,"andar":27,"andaresPredio":15,"elevadores":null,"peDireito":null,"anoConstrucao":2020,"anoReforma":null,"condominio":700,"iptu":null,"precoM2":13320,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":null,"locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"André","celular":"(11) 94746-4495","creci":null}}