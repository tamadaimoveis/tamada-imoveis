as de garagem, churrasqueira, jardim.\r\n\r\nÓtima localização, apenas 5 minutos do metrô Patriarca, radial leste, amplo transporte púbico, próximo a feiras livres, escolas, farmácias, UBS, igrejas, academia, padaria, supermercado. Vale a pena conferir.\r\nAgende sua visita com um de nossos corretores!","comodidades":["Churrasqueira","Sacada / Varanda","Quintal","Área de Serviço","Copa","Portão Eletrônico","Aceita Pet","Água","Esgoto","Energia Elétrica","Rua Asfaltada","Garagem Coberta","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato","Taco de Madeira"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Sobrado Residencial","finalidade":"residencial","areaUtil":149,"areaTotal":null,"quartos":3,"suites":null,"banheiros":2,"salas":1,"vagas":2,"vagasCobertas":2,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":1998,"anoReforma":null,"condominio":null,"iptu":0.01,"precoM2":5362.42,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":null,"videoInstitucional":false,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}