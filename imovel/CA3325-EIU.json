im Nordeste - São Paulo/SP\r\n\r\n170 m² de área construída - Sobrado com 3 quartos sendo 1 Suíte, Sala  ampla Cozinha 3 banheiros,  Lavabo, Garagem subterrânea para 4 Carros, Portão Automático, Churrasqueira, Lavanderia.\r\n\r\nPróximo ao Comércio como Supermercado Farmácia Padaria.\r\nCondução para o Metrô  passa perto.\r\n\r\nO bairro conta com diversas opções de comércio, serviços, escolas e acesso a transporte público, facilitando a locomoção para outras regiões da cidade.\r\n\r\nCaracterísticas do Jardim Nordeste\r\nComércio e Serviços: O bairro possui uma variedade de lojas, mercados, farmácias e restaurantes que atendem às necessidades dos moradores.\r\n\r\nTransporte: A região é bem servida por linhas de ônibus e, nas proximidades, há acesso a estações de metrô que conectam os moradores a outras partes da cidade.\r\n\r\n* Imóvel atualmente está alugado.\r\n\r\nAceita financiamento !\r\n\r\nAgende uma visita com um de nossos corretores !\r\n.","comodidades":["Churrasqueira","Sacada / Varanda","Quintal","Lavabo","Jardim de Inverno","Portão Eletrônico","Água","Esgoto","Energia Elétrica","Rua Asfaltada","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato","Laminado"],"garantias":[],"pagamento":["Financiamento bancário","Permuta"],"tags":[],"ficha":{"subTipo":"Casa Residencial","finalidade":"residencial","areaUtil":170,"areaTotal":82,"quartos":3,"suites":1,"banheiros":2,"salas":1,"vagas":4,"vagasCobertas":4,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2003,"anoReforma":null,"condominio":null,"iptu":null,"precoM2":4088.24,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Desocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Camara","celular":"(11) 97709-4147","creci":null}}