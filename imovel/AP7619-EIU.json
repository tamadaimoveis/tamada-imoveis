rão acrescenta praticidade e comodidade na rotina dos que residem no local.","comodidades":["Sacada / Varanda","Área de Serviço","Condomínio Fechado","Cozinha com Área de Serviço","Frente Mar","Beira Mar"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":["Lançamento"],"ficha":{"subTipo":"Apartamento de Condomínio","finalidade":"residencial","areaUtil":38,"areaTotal":null,"quartos":2,"suites":null,"banheiros":1,"salas":1,"vagas":1,"vagasCobertas":null,"vagasDescobertas":1,"tipoVaga":null,"andar":1,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2025,"anoReforma":null,"condominio":520,"iptu":0.01,"precoM2":9815.79,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":null,"locado":null,"exclusividade":false,"zoneamento":null,"obra":"Lançamento"},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"André","celular":"(11) 94746-4495","creci":null}}