a oportunidade única de adquirir uma propriedade que combina espaço, comodidade e elegância em um dos bairros mais vibrantes da cidade. Não deixe de considerar esta casa como seu novo lar!","comodidades":["Quintal","Área de Serviço","Aceita Pet","Esgoto","Energia Elétrica","Cozinha com Área de Serviço"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Sobrado Residencial","finalidade":"residencial","areaUtil":187,"areaTotal":273,"quartos":4,"suites":1,"banheiros":3,"salas":1,"vagas":6,"vagasCobertas":null,"vagasDescobertas":6,"tipoVaga":null,"andar":null,"andaresPredio":2,"elevadores":null,"peDireito":null,"anoConstrucao":1974,"anoReforma":null,"condominio":null,"iptu":400,"precoM2":4010.7,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":"Ocupado","locado":true,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}