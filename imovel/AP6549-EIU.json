 Colégio Amorim Tatuapé, Silvio Romero Plaza e Estação Carrão, sua vida cotidiana será ainda mais conveniente e prática.\r\n\r\nNão perca a oportunidade de garantir seu novo lar em um dos melhores bairros de São Paulo! Agende já uma visita e apaixone-se por este incrível apartamento. Entre em contato para mais informações e não deixe essa oportunidade escapar!","comodidades":["Piscina","Churrasqueira","Quadra Poliesportiva","Sacada / Varanda","Área de Serviço","Aceita Pet","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Apartamento Residencial","finalidade":"residencial","areaUtil":70,"areaTotal":null,"quartos":3,"suites":1,"banheiros":2,"salas":1,"vagas":2,"vagasCobertas":2,"vagasDescobertas":null,"tipoVaga":null,"andar":13,"andaresPredio":18,"elevadores":null,"peDireito":null,"anoConstrucao":null,"anoReforma":null,"condominio":800,"iptu":0.01,"precoM2":9985.71,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":null,"locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/VTeOzy8J-hk","videoInstitucional":true,"tour":null,"corretor":{"nome":"André","celular":"(11) 94746-4495","creci":null}}