, sala de games, salão de festas e espaço pet. Com tantas opções, há sempre algo para fazer e aproveitar. O grande destaque deste imóvel é sua localização privilegiada. Situado na Vila Esperança, o apartamento está a apenas 5 minutos do metrô Vila Matilde, o que facilita a locomoção e o acesso a diversas regiões da cidade.","comodidades":["Piscina","Churrasqueira","Sacada / Varanda","Lavabo","Área de Serviço","Ar Condicionado","Interfone","Portão Eletrônico","Mobiliado","Garagem Coberta","Armários Planejados"],"acabamentos":["Porcelanato"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":["Lançamento"],"ficha":{"subTipo":"Apartamento Residencial","finalidade":"residencial","areaUtil":46,"areaTotal":null,"quartos":2,"suites":null,"banheiros":1,"salas":1,"vagas":1,"vagasCobertas":1,"vagasDescobertas":null,"tipoVaga":null,"andar":8,"andaresPredio":27,"elevadores":null,"peDireito":null,"anoConstrucao":2020,"anoReforma":null,"condominio":600,"iptu":150,"precoM2":10652.17,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":"Lançamento"},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Claudio Domingues","celular":"(11) 97795-5441","creci":null}}