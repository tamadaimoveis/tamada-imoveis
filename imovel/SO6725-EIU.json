 pizza e fogão a lenha\r\nPiscina orgânica e jacuzzi\r\nJardim fabuloso com paisagismo moderno e iluminação em LED\r\nÁrea de lazer com mesa de bilhar, pingue-pongue e pebolim\r\nConveniências Extras:\r\n\r\nEscritório espaçoso\r\nDependências para empregados\r\nReuso de água de chuva para irrigação do jardim\r\nAcabamentos de primeira linha e custo de manutenção baixo\r\nAquecimento a gás e solar para economia e eficiência\r\nFácil acesso a rodovias e comércios locais\r\nLocalização Privilegiada:\r\nDesfrute de proximidade com escolas, restaurantes, padarias, hipermercados, delegacia civil, estúdios de yoga, academias e muito mais. Apenas 33 minutos do Aeroporto Internacional de Guarulhos, esta mansão oferece um estilo de vida exclusivo e conveniente.","comodidades":["Piscina","Churrasqueira","Hidromassagem","Sacada / Varanda","Terraço","Quintal","Lavabo","Área de Serviço","Copa","Despensa","Escritório","Closet","Depósito","Jardim de Inverno","Lareira","Adega","Dormitório Reversível","Dormitório de Empregada","WC de Empregada","Interfone","Portão Eletrônico","Mobiliado","Água","Esgoto","Rua Asfaltada","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato"],"garantias":[],"pagamento":["Financiamento bancário","Permuta"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Sobrado Residencial","finalidade":"residencial","areaUtil":1000,"areaTotal":1000,"quartos":5,"suites":5,"banheiros":8,"salas":4,"vagas":10,"vagasCobertas":6,"vagasDescobertas":4,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2003,"anoReforma":null,"condominio":null,"iptu":800,"precoM2":6000,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/VTeOzy8J-hk","videoInstitucional":true,"tour":null,"corretor":{"nome":"Camara","celular":"(11) 97709-4147","creci":null}}