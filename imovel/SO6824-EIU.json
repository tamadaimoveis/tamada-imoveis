ages/v3whr4as/production/48828eec972e9ade62bc912fb65fedee97851c1a-720x479.jpg","https://cdn.sanity.io/images/v3whr4as/production/9b80aef4ae3aeaceaddb753a3ffcd7e0b7e1c2d7-720x479.jpg","https://cdn.sanity.io/images/v3whr4as/production/1d261dded25c63242519c4c26880a3a1a9c17939-720x479.jpg","https://cdn.sanity.io/images/v3whr4as/production/cec431804bcb0730fcfe5f678e6f13616e5640b2-720x479.jpg","https://cdn.sanity.io/images/v3whr4as/production/8ea092e0557352c5aae000e45721cd9bebe6c77e-720x479.jpg","https://cdn.sanity.io/images/v3whr4as/production/297cee97208261f8e0a15c894db0fd7565778bca-720x479.jpg","https://cdn.sanity.io/images/v3whr4as/production/5c956cc093a01e6bd5eb2276bb0aeaf4990e86e9-720x479.jpg","https://cdn.sanity.io/images/v3whr4as/production/29ee107d7362c9a2a2ad64ccd5c38254d5203c6d-720x479.jpg","https://cdn.sanity.io/images/v3whr4as/production/0a65735b950102c32f2b27b0009f6f9766253aef-720x479.jpg","https://cdn.sanity.io/images/v3whr4as/production/6ed8cab03d9a5ff7aafb8ded14c763d1c914380b-720x479.jpg","https://cdn.sanity.io/images/v3whr4as/production/e3433e572cfb1229a8a97cc7cb9923d7c34ef1e9-720x479.jpg"],"descricao":"Sobrado com 3 quartos à venda, 240 m² - Engenheiro Goulart - São Paulo/SP\r\n\r\nParte Superior: 03 quartos, incluindo uma suíte, e mais um banheiro, garantindo privacidade e conforto para todos.\r\nSegundo Pavimento (Nível da Rua): Garagem coberta para dois carros com portão automático, sala ampla para dois ambientes (estar/jantar), lavabo, cozinha e lavanderia interna coberta.\r\nTerceiro Pavimento: Salão espaçoso com varanda, perfeito para momentos de lazer e convívio.\r\nQuarto Pavimento: Dois cômodos adicionais, banheiro e área externa, proporcionando flexibilidade de uso e espaço extra.\r\nQuinto Pavimento: Porão/Depósito amplo e arejado, com janela, ideal para armazenamento ou possíveis conversões.\r\n\r\nCaracterísticas Destacadas:\r\n\r\nDimensão do Terreno: 4,80 x 34,50, oferecendo uma área generosa para aproveitar.\r\n\r\nLocalização estratégica próximo a diversos pontos importantes, como a Estação CTPM Engenheiro Goulart, o Parque Ecológico Tietê, o Teatro Municipal Flávio Império, entre outros.\r\n\r\nProximidade com uma variedade de comércios e serviços, incluindo padarias, açougues, farmácias, mercados, escolas, entre outros.\r\nFacilidade de acesso a transporte público, como ponto de ônibus circular e ponto de táxi, além da proximidade com a USP Leste.\r\n\r\nNão aceita financiamento.","comodidades":["Quintal","Lavabo","Área de Serviço","Escritório","Dormitório de Empregada","Interfone","Portão Eletrônico","Garagem Coberta","Cozinha com Área de Serviço"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":[],"tags":[],"ficha":{"subTipo":"Sobrado Residencial","finalidade":"residencial","areaUtil":240,"areaTotal":123,"quartos":3,"suites":2,"banheiros":3,"salas":1,"vagas":2,"vagasCobertas":2,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2000,"anoReforma":null,"condominio":null,"iptu":35.54,"precoM2":2791.67,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":"Desocupado","locado":null,"exclusividade":false,"zoneamento":"ZM","obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}