es, sancas e teto rebaixado com lâmpadas dicroicas;\r\n- Cozinha ampla com armários planejados novos, ilha com fogão cooktop, balcão da pia em pedra, janela de correr com vidros verdes  e piso em porcelanato polido;\r\n- Na cozinha foi instalado teto rebaixado, sancas e lâmpadas dicroicas;\r\n- Ainda na cozinha foi planejado um Canto Alemão, espaço para lanches ou jantar;\r\n- Lavanderia externa coberta ;\r\n- Espaço nos fundos, coberto, com depósito e banheiro;\r\n- Área gourmet com churrasqueira e pia;\r\n\r\nEste imóvel está dentro do que você está procurando?\r\n\r\nEntre em contato e tenha a garantia do melhor atendimento e todo suporte necessário a realização de seu sonho. \r\n\r\nEste imóvel pode ser financiado.","comodidades":["Churrasqueira","Quintal","Lavabo","Copa","Closet","Interfone","Portão Eletrônico","Mobiliado","Aceita Pet","Água","Esgoto","Energia Elétrica","Rua Asfaltada","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Sobrado Residencial","finalidade":"residencial","areaUtil":120,"areaTotal":150,"quartos":3,"suites":1,"banheiros":3,"salas":2,"vagas":2,"vagasCobertas":2,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":2,"elevadores":null,"peDireito":null,"anoConstrucao":1990,"anoReforma":null,"condominio":0.01,"iptu":null,"precoM2":7075,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":"Desocupado","locado":null,"exclusividade":false,"zoneamento":"ZM","obra":null},"video":"https://youtu.be/VTeOzy8J-hk","videoInstitucional":true,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}