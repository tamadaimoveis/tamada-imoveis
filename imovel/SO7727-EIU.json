72400199-576x768.jpg","https://cdn.sanity.io/images/v3whr4as/production/a945c491279ea665103a8e2710a9c5094d1bf4aa-1024x768.jpg","https://cdn.sanity.io/images/v3whr4as/production/62a8e54cb0af0eb201f811bc3908272d2a3bad8c-1024x768.jpg"],"descricao":"Sobrado 3 Quartos 1 Suítes Cozinha 2 Banheiros 1 Lavabo 2 Vagas de Garagem cobertas Varanda com Churrasqueira entrada lateral\r\n(TEM RISCO DE ALAGAMENTO COM CHUVAS FORTES)\r\nVila Marieta é um bairro localizado na cidade de São Paulo, próximo aos bairros Vila Salete, Vila Rui Barbosa e Vila Araguaia. As principais vias de acesso incluem as estações de metrô Guilhermina Esperança e Vila Matilde, facilitando a mobilidade dos moradores. O valor médio do aluguel por metro quadrado na região é de R$ 32,24/mês, enquanto para compra é de R$ 5.510,53/m². \r\nO bairro oferece uma variedade de estabelecimentos comerciais, escolas e serviços, proporcionando comodidade aos moradores. Além disso, a proximidade com importantes vias de acesso e estações de metrô torna Vila Marieta uma opção atrativa para quem busca residir na Zona Leste de São Paulo.","comodidades":["Churrasqueira","Sacada / Varanda","Quintal","Lavabo","Área de Serviço","Portão Eletrônico","Água","Esgoto","Energia Elétrica","Rua Asfaltada","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Sobrado Residencial","finalidade":"residencial","areaUtil":107,"areaTotal":106,"quartos":3,"suites":1,"banheiros":2,"salas":1,"vagas":2,"vagasCobertas":2,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2000,"anoReforma":null,"condominio":null,"iptu":null,"precoM2":7476.64,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"co