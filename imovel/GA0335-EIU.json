arte final e 4.5 metros na inicial, permitindo assim a entrada de veículos grandes.\r\n\r\nImóvel de esquina com 2 acessos, portão lateral e portão de esquina. Ideal para carga e descarga.\r\n\r\nInstalação de água e luz Funcionando.\r\n\r\nIdeal para oficina mecânica e centros automotivos.\r\n\r\nDepósito de gás, materiais de construção, entre outros ramos.\r\n\r\nAgende uma visita com um de nossos corretores e não deixe passar esta oportunidade!","comodidades":["Água","Esgoto","Energia Elétrica","Rua Asfaltada"],"acabamentos":[],"garantias":["Caução","Fiador","Seguro Fiança"],"pagamento":[],"tags":["Alto Padrão"],"ficha":{"subTipo":"Galpão Comercial","finalidade":"comercial","areaUtil":125,"areaTotal":null,"quartos":null,"suites":null,"banheiros":null,"salas":null,"vagas":null,"vagasCobertas":null,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":600,"anoConstrucao":2018,"anoReforma":null,"condominio":null,"iptu":80,"precoM2":null,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Desocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Maria Helena","celular":"(11) 97111-9161","creci":null}}