iros gabinetes planejados e box, \r\n\r\nA casa tem laje em cima podendo ser feito um sótão ou até mesmo um terceiro andar. \r\n\r\nConstruido há 6 anos, muito bem localizado em rua tranquila e bem iluminada no bairro Jd. Triana, próximo ao metrô Guilhermina\r\n\r\nCercado por comércio e serviços, tais como farmácias, mercados, padarias, feiras, lojas e comércios em geral. \r\n\r\nA casa é bem clara e arejada, com piso porcelanato em todos os cômodos, possui garagem para 2 carros e 1 moto, com portão automático com trava de segurança totalmente fechado, com sirene e luzes de alerta. \r\n\r\n\r\nDocumentação toda em dia, escritura, matrícula, iptu tudo ok! \r\n\r\nAceita financiamento, aceita carro como parte do pagamento.","comodidades":["Churrasqueira","Sacada / Varanda","Lavabo","Área de Serviço","Interfone","Água","Garagem Coberta","Cozinha com Área de Serviço"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Sobrado Residencial","finalidade":"residencial","areaUtil":150,"areaTotal":null,"quartos":3,"suites":1,"banheiros":2,"salas":1,"vagas":2,"vagasCobertas":2,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2000,"anoReforma":null,"condominio":null,"iptu":null,"precoM2":5033.33,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":null,"locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/VTeOzy8J-hk","videoInstitucional":true,"tour":null,"corretor":{"nome":"André","celular":"(11) 94746-4495","creci":null}}