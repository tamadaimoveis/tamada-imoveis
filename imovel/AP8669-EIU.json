a comercial completa, incluindo supermercados, padarias, farmácias, petshops, escolas e diversos serviços.\r\n\r\nAceita financiamento !\r\n\r\nAgende uma visita com um dos nossos corretores !!","comodidades":["Piscina","Churrasqueira","Quadra Poliesportiva","Sacada / Varanda","Varanda Gourmet","Área de Serviço","Escritório","Pé-direito Duplo","Ar Condicionado","Interfone","Portão Eletrônico","TV a Cabo","Zelador","Mobiliado","Aceita Pet","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato","Cerâmica"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Apartamento Residencial","finalidade":"residencial","areaUtil":80,"areaTotal":null,"quartos":2,"suites":1,"banheiros":1,"salas":2,"vagas":1,"vagasCobertas":1,"vagasDescobertas":null,"tipoVaga":null,"andar":12,"andaresPredio":14,"elevadores":null,"peDireito":null,"anoConstrucao":1996,"anoReforma":null,"condominio":1250,"iptu":98,"precoM2":9375,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":"ZEUP","obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}