art - São Paulo/SP\r\n\r\nÁrea do terreno: 5 x 36m = 180 m² / Área construída: 175m².\r\n\r\nSobrado frontal com 3 quartos sendo 1 suíte, varanda, sala, cozinha, 3 banheiros, lavanderia e 4 vagas de garagem.\r\n\r\nBanheira de hidromassagem / Box / Varanda / Armários no quarto / Armários nos banheiros / Armários na cozinha / Fogão incluso / Geladeira inclusa / Quintal\r\n\r\nA localização é excepcional, estando próxima à Estação Engenheiro Goulart, garantindo fácil acesso ao transporte público. \r\n\r\nAproveite a oportunidade de morar em um lugar que combina tranquilidade e conveniência.\r\n\r\nSomente pagamento a vista !\r\n\r\nAgende uma visita com um de nossos corretores !!","comodidades":["Churrasqueira","Hidromassagem","Sacada / Varanda","Terraço","Quintal","Lavabo","Área de Serviço","Portão Eletrônico","Mobiliado","Água","Esgoto","Energia Elétrica","Rua Asfaltada","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":[],"tags":["Alto Padrão"],"ficha":{"subTipo":"Casa Residencial","finalidade":"residencial","areaUtil":175,"areaTotal":180,"quartos":3,"suites":1,"banheiros":4,"salas":1,"vagas":4,"vagasCobertas":4,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":1985,"anoReforma":null,"condominio":null,"iptu":138,"precoM2":5142.86,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Camara","celular":"(11) 97709-4147","creci":null}}