cias, Posto de Saúde e da estação da CPTM.\r\n\r\nFácil acesso a transporte publico, comercio local e principais vias de acesso\r\n\r\nAceita financiamento !\r\n\r\nAgende uma visita com um de nossos corretores !!","comodidades":["Churrasqueira","Quadra Poliesportiva","Área de Serviço","Interfone","Portão Eletrônico","Aceita Pet","Condomínio Fechado","Elevador","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Apartamento de Condomínio","finalidade":"residencial","areaUtil":45,"areaTotal":null,"quartos":2,"suites":null,"banheiros":1,"salas":1,"vagas":1,"vagasCobertas":null,"vagasDescobertas":1,"tipoVaga":null,"andar":13,"andaresPredio":null,"elevadores":1,"peDireito":null,"anoConstrucao":2012,"anoReforma":null,"condominio":377,"iptu":null,"precoM2":4933.33,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Alberto Kahakami","celular":"(11) 95000-3956","creci":null}}