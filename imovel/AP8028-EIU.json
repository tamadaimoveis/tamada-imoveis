es:\r\n2 quartos com móveis planejados\r\n1 vaga de garagem\r\nCondomínio com lazer completo\r\nExcelente conservação\r\nAcesso rápido ao metrô e principais vias da zona leste\r\n\r\nAgende já uma visita com um de nossos consultores e venha conhecer seu novo lar!","comodidades":["Piscina","Churrasqueira","Quadra Poliesportiva","Sacada / Varanda","Área de Serviço","Copa","Interfone","Portão Eletrônico","TV a Cabo","Aceita Pet","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Cerâmica","Laminado"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Apartamento Residencial","finalidade":"residencial","areaUtil":50,"areaTotal":null,"quartos":2,"suites":null,"banheiros":1,"salas":2,"vagas":1,"vagasCobertas":1,"vagasDescobertas":null,"tipoVaga":null,"andar":9,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2010,"anoReforma":null,"condominio":600,"iptu":null,"precoM2":8600,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":null,"locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Marcio","celular":"(11) 94022-9631","creci":null}}