2db0-576x768.jpg","https://cdn.sanity.io/images/v3whr4as/production/91e7a8c432bc19b540fa370d800a4f24fac99dbc-576x768.jpg"],"descricao":"Sobrado de Alto Padrão Próximo à Rua do Tatuapé!\r\n\r\nEste incrível sobrado oferece tudo que você procura em um lar: localização privilegiada, espaço e qualidade inigualável.\r\n\r\nCom 3 dormitórios, incluindo uma suíte espaçosa, e uma generosa garagem com espaço para até 6 veículos, esta residência é perfeita para famílias que valorizam conforto e praticidade.\r\n\r\nO acabamento de primeira qualidade e o bom gosto estão presentes em cada detalhe, proporcionando um ambiente sofisticado e acolhedor.\r\n\r\nAlém disso, o imóvel conta com corredor lateral, quintal e churrasqueira, ideais para momentos de lazer e entretenimento com amigos e familiares.\r\n\r\nSua localização estratégica oferece fácil acesso à Avenida Marginal Tietê, Avenida Celso Garcia, Metrô Vila Carrão e Metrô Tatuapé, garantindo mobilidade e conveniência no dia a dia.\r\n\r\nNão perca tempo, agende agora mesmo uma visita com um de nossos corretores e descubra a sua próxima moradia dos sonhos!","comodidades":["Churrasqueira","Sacada / Varanda","Quintal","Lavabo","Área de Serviço","Copa","Despensa","Escritório","Depósito","Interfone","Portão Eletrônico","TV a Cabo","Aceita Pet","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato","Cerâmica","Granito","Mármore"],"garantias":[],"pagamento":["Financiamento bancário","Permuta"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Sobrado Residencial","finalidade":"residencial","areaUtil":245,"areaTotal":225,"quartos":3,"suites":1,"banheiros":4,"salas":3,"vagas":6,"vagasCobertas":3,"vagasDescobertas":3,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2020,"anoReforma":null,"condominio":null,"iptu":null,"precoM2":6857.14,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Desocupado","locado":null,"exclusividade":false,"zoneament