úblicas.\r\n\r\nNão perca esta oportunidade de viver com conforto e conveniência em um dos bairros mais dinâmicos de São Paulo. Agende já sua visita e venha conhecer seu novo lar!","comodidades":["Churrasqueira","Lavabo","Área de Serviço","Interfone","Água","Esgoto","Energia Elétrica","Rua Asfaltada","Garagem Coberta","Cozinha com Área de Serviço"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Sobrado Residencial","finalidade":"residencial","areaUtil":84,"areaTotal":97,"quartos":3,"suites":1,"banheiros":2,"salas":1,"vagas":2,"vagasCobertas":2,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":null,"anoReforma":null,"condominio":null,"iptu":null,"precoM2":6904.76,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/VTeOzy8J-hk","videoInstitucional":true,"tour":null,"corretor":{"nome":"Camara","celular":"(11) 97709-4147","creci":null}}