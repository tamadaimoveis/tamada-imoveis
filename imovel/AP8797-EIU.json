as e reconhecimento facial, além de dois elevadores. \r\n\r\nO bairro oferece uma boa variedade de comércios locais, supermercados, farmácias, escolas e serviços essenciais, Além disso, a região está próxima de bairros importantes como Penha e Vila Matilde, ampliando ainda mais as opções de lazer, compras e transporte, incluindo acesso a linhas de metrô e ônibus.\r\n\r\nAceita financiamento !\r\n\r\nAgende uma visita com um dos nossos corretores !!","comodidades":["Churrasqueira","Quadra Poliesportiva","Lavabo","Área de Serviço","Solário","Interfone","Portão Eletrônico","TV a Cabo","Zelador","Aceita Pet","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Apartamento Residencial","finalidade":"residencial","areaUtil":46,"areaTotal":null,"quartos":2,"suites":null,"banheiros":1,"salas":1,"vagas":1,"vagasCobertas":1,"vagasDescobertas":null,"tipoVaga":null,"andar":5,"andaresPredio":12,"elevadores":null,"peDireito":null,"anoConstrucao":2000,"anoReforma":2026,"condominio":486,"iptu":null,"precoM2":6739.13,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":"ZC","obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}