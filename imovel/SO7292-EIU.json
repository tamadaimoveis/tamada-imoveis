o dos quartos em madeira maciça e planejado em todos eles.\r\n    -sala de 3 ambientes sendo 2 com piso madeira maciça,idem escadas.\r\n    -sala principal com piso porcelanato , porta toda envidraçada + balcão e pia de ganito.\r\n     -cozinha com piso de granito,planejado moderno,contendo ao lado ,área de serviço com armário + área de despensa.\r\n    -edicula com entrada independente pelo lado do muro protegido com cerca elétrica,sendo sala, copa,dormitório banheiro social + área de serviço.\r\n\r\n     -sobrado com ambientes internos de ótimo tamanho ,vaga para 4 carros sendo 2 coberto ,portão automático e localização tranquila com ótimos vizinhos.","comodidades":["Hidromassagem","Quintal","Lavabo","Copa","Despensa","Escritório","Depósito","Mezanino","Dormitório de Empregada","WC de Empregada","Interfone","Portão Eletrônico","Mobiliado","Aceita Pet","Água","Esgoto","Energia Elétrica","Rua Asfaltada","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato","Cerâmica","Granito"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Sobrado Residencial","finalidade":"residencial","areaUtil":250,"areaTotal":300,"quartos":4,"suites":1,"banheiros":4,"salas":4,"vagas":4,"vagasCobertas":2,"vagasDescobertas":2,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":1990,"anoReforma":null,"condominio":null,"iptu":2880,"precoM2":5200,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Makiya","celular":"(11) 98539-3772","creci":null}}