idade na rotina dos que residem no local.\r\n\r\nAceita financiamento !\r\n\r\nAgende uma visita com um de nossos corretores !!","comodidades":["Piscina","Churrasqueira","Quadra Poliesportiva","Área de Serviço","Interfone","Portão Eletrônico","Alarme","Aceita Pet","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":[],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Apartamento Residencial","finalidade":"residencial","areaUtil":44,"areaTotal":null,"quartos":2,"suites":null,"banheiros":1,"salas":1,"vagas":1,"vagasCobertas":null,"vagasDescobertas":1,"tipoVaga":null,"andar":9,"andaresPredio":12,"elevadores":null,"peDireito":null,"anoConstrucao":2021,"anoReforma":2024,"condominio":520,"iptu":null,"precoM2":6136.36,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":null,"locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Sandro","celular":"(11) 96204-1814","creci":null}}