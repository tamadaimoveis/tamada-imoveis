plo, veículos que não sejam de leilão e terrenos em Campinas-SP e região, Praia Grande - SP ou Vitória da Conquista -BA.","comodidades":["Área de Serviço","Água","Garagem Coberta","Cozinha com Área de Serviço"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":["Financiamento bancário","Permuta"],"tags":[],"ficha":{"subTipo":"Casa Residencial","finalidade":"residencial","areaUtil":220,"areaTotal":150,"quartos":1,"suites":1,"banheiros":1,"salas":1,"vagas":1,"vagasCobertas":1,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":1999,"anoReforma":null,"condominio":null,"iptu":null,"precoM2":3181.82,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Camara","celular":"(11) 97709-4147","creci":null}}