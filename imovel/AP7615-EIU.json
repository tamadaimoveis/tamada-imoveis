te o espírito vibrante de São Paulo. Localizado na Rua Ernesto de Castro, disponibiliza vários recursos para trazer comodidade e aconchego ao dia a dia dos moradores.\r\n\r\nContando com portaria 24 horas, elevador, academia, piscina, quadra esportiva, salão de festas, gás encanado, churrasqueira, playground, salão de jogos e brinquedoteca, o Condomínio Praça Mooca é preparado para atender às necessidades dos moradores que buscam lazer e conforto em um só lugar.\r\n\r\nA proximidade com Estação Brás, Parque Benemérito José Brás, Estação Bresser-Mooca, Escola de Modelo, Feirinha da Concórdia e Estação Juventus - Mooca acrescenta praticidade e comodidade na rotina dos que residem no local.","comodidades":["Piscina","Churrasqueira","Sauna","Quadra Poliesportiva","Sacada / Varanda","Área de Serviço","Aceita Pet","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço","Frente Mar","Beira Mar"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Apartamento Residencial","finalidade":"residencial","areaUtil":69,"areaTotal":null,"quartos":2,"suites":1,"banheiros":2,"salas":1,"vagas":1,"vagasCobertas":1,"vagasDescobertas":null,"tipoVaga":null,"andar":13,"andaresPredio":18,"elevadores":null,"peDireito":null,"anoConstrucao":2015,"anoReforma":null,"condominio":800,"iptu":0.01,"precoM2":11579.71,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":null,"locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"André","celular":"(11) 94746-4495","creci":null}}