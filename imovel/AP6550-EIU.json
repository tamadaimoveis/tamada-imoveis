, Bresser e Sé, garantindo mobilidade e praticidade para o seu dia a dia.\r\n\r\nCondomínio Completo:\r\nDesfrute de todas as comodidades que o condomínio oferece:\r\nPortaria 24 horas para a sua segurança.\r\nPiscina para se refrescar nos dias de calor.\r\nAcademia equipada para manter a forma.\r\nSalão de festas para comemorações especiais.\r\nQuadra para praticar esportes e se divertir com a família.\r\n\r\nNão perca esta oportunidade única de morar em um lugar que oferece conforto, segurança e praticidade. Agende agora mesmo sua visita e venha conhecer seu novo lar!","comodidades":["Piscina","Churrasqueira","Quadra Poliesportiva","Sacada / Varanda","Área de Serviço","Aceita Pet","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Apartamento Residencial","finalidade":"residencial","areaUtil":88,"areaTotal":null,"quartos":3,"suites":2,"banheiros":3,"salas":1,"vagas":1,"vagasCobertas":null,"vagasDescobertas":1,"tipoVaga":null,"andar":3,"andaresPredio":20,"elevadores":null,"peDireito":null,"anoConstrucao":null,"anoReforma":null,"condominio":1200,"iptu":null,"precoM2":7261.36,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":null,"locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/VTeOzy8J-hk","videoInstitucional":true,"tour":null,"corretor":{"nome":"André","celular":"(11) 94746-4495","creci":null}}