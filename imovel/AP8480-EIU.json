 - Unidade I. Além disso, a região conta com áreas de lazer, como a Praça Juvenal Medeiros e a Praça Nossa Senhora de Fátima, que oferecem espaços para atividades ao ar livre e convivência comunitária.\r\nA área é predominantemente residencial, com comércio local que atende às necessidades dos moradores, incluindo mercados, padarias e farmácias. A infraestrutura de transporte público é acessível, facilitando o deslocamento para outras partes da cidade.","comodidades":["Piscina","Churrasqueira","Sacada / Varanda","Lavabo","Área de Serviço","Interfone","Portão Eletrônico","Aceita Pet","Condomínio Fechado","Elevador","Garagem Coberta","Armários Planejados"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Apartamento de Condomínio","finalidade":"residencial","areaUtil":59,"areaTotal":null,"quartos":2,"suites":1,"banheiros":1,"salas":1,"vagas":1,"vagasCobertas":1,"vagasDescobertas":null,"tipoVaga":null,"andar":4,"andaresPredio":10,"elevadores":2,"peDireito":null,"anoConstrucao":2013,"anoReforma":null,"condominio":574.39,"iptu":null,"precoM2":6254.24,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Desocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":null,"videoInstitucional":false,"tour":null,"corretor":{"nome":"Claudio Domingues","celular":"(11) 97795-5441","creci":null}}