io Amorim Ermelino e da Escola Estadual Marinha do Brasil e Restaurante Chico na Av São Miguel. Fácil acesso à UBS Carlos Olivaldo de Souza Lopes.\r\n\r\nPróximo ao Parque Linear Dario Costa (Tiquatira).\r\n\r\nAgende uma visita com um dos nossos corretores !!","comodidades":["Churrasqueira","Hidromassagem","Quintal","Área de Serviço","Copa","Interfone","Portão Eletrônico","TV a Cabo","Aceita Pet","Água","Esgoto","Energia Elétrica","Rua Asfaltada","Garagem Coberta","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato","Carpete"],"garantias":[],"pagamento":["Financiamento bancário","Permuta"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Casa Residencial","finalidade":"residencial","areaUtil":358,"areaTotal":432,"quartos":3,"suites":3,"banheiros":6,"salas":2,"vagas":8,"vagasCobertas":4,"vagasDescobertas":4,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":1997,"anoReforma":null,"condominio":null,"iptu":3700,"precoM2":3491.62,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}