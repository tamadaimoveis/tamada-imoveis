ing Itaquera;\r\n\r\nAcesso à Avenida Líder, Avenida Radial Leste, Avenida Jacu Pêssego e Rodoanel Mário Covas.\r\n\r\nEste imóvel é financiável, atendendo a todos os requisitos bancários e facilitando o processo para você que deseja realizar o sonho de um novo lar. \r\n\r\nSendo este o tipo de imóvel que você está procurando, entre em contato com a Tamada Imóveis. \r\n\r\nCom uma equipe preparada para oferecer o melhor atendimento e todo o suporte necessário, garantimos uma experiência de compra segura e tranquila. \r\n\r\nA Tamada Imóveis é sinônimo de segurança, conforto e confiabilidade em todas as etapas de seu negócio","comodidades":["Quadra Poliesportiva","Área de Serviço","Interfone","Portão Eletrônico","Zelador","Aceita Pet","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Apartamento Residencial","finalidade":"residencial","areaUtil":60,"areaTotal":null,"quartos":2,"suites":null,"banheiros":1,"salas":2,"vagas":1,"vagasCobertas":null,"vagasDescobertas":1,"tipoVaga":null,"andar":5,"andaresPredio":5,"elevadores":null,"peDireito":null,"anoConstrucao":1991,"anoReforma":null,"condominio":515,"iptu":null,"precoM2":4600,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":null,"videoInstitucional":false,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}