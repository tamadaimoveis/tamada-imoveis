sso: Av. São Miguel, Av do Imperador,  Av. Águia de Haia.\r\n\r\nAgende uma visita com um de nossos corretores !!","comodidades":["Churrasqueira","Hidromassagem","Terraço","Quintal","Área de Serviço","Copa","TV a Cabo","Aceita Pet","Água","Esgoto","Energia Elétrica","Rua Asfaltada","Garagem Coberta","Cozinha com Área de Serviço"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Casa Residencial","finalidade":"residencial","areaUtil":126,"areaTotal":148,"quartos":2,"suites":1,"banheiros":2,"salas":2,"vagas":4,"vagasCobertas":2,"vagasDescobertas":2,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":1992,"anoReforma":null,"condominio":null,"iptu":null,"precoM2":3809.52,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}