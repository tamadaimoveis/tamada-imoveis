e garagem. \r\n\r\nA suíte dispõe de varanda privativa com ampla vista.\r\n\r\nO imóvel está localizado na Rua Rubens Galvão de França, próximo às Avenidas São Miguel e Boturussu, na mesma rua do Colégio Amorim Ermelino. Além disso, encontra-se próximo ao Parque Linear Dario Costa, ao Hospital Municipal Ermelino Matarazzo e à UBS Carlos Olivaldo de Souza Lopes Muniz. Não perca essa oportunidade única! \r\nAgende sua visita!","comodidades":["Churrasqueira","Quintal","Lavabo","Área de Serviço","Aceita Pet","Água","Esgoto","Energia Elétrica","Rua Asfaltada","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato","Cerâmica"],"garantias":[],"pagamento":[],"tags":["Alto Padrão"],"ficha":{"subTipo":"Casa Residencial","finalidade":"residencial","areaUtil":277,"areaTotal":null,"quartos":3,"suites":1,"banheiros":3,"salas":1,"vagas":1,"vagasCobertas":1,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":1998,"anoReforma":null,"condominio":null,"iptu":0.01,"precoM2":2996.39,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":null,"videoInstitucional":false,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}