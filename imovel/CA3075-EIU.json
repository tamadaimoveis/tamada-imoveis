-condicionado, gás encanado na cozinha, projeto estrutural, elétrico e hidrossanitário, estrutura para energia solar fotovoltaica, LED na fachada do imóvel, LED nas escadas com sensor, LED nos nichos dos banheiros, vasos sanitários monobloco, granito São Gabriel, porta principal pivotante com fechadura digital.\r\n\r\nLocalização privilegiada - Próximo ao Shopping Penha, padaria Requinte, farmácia, feira livre, pet shop e comércios em geral.\r\n\r\nAceita financiamento !\r\n\r\nAgende uma visita com um dos nossos corretores !!","comodidades":["Churrasqueira","Sacada / Varanda","Quintal","Lavabo","Área de Serviço","Copa","Interfone","Portão Eletrônico","Aceita Pet","Água","Esgoto","Energia Elétrica","Garagem Coberta","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato"],"garantias":[],"pagamento":["Financiamento bancário","Permuta"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Casa Residencial","finalidade":"residencial","areaUtil":198,"areaTotal":105,"quartos":3,"suites":3,"banheiros":4,"salas":2,"vagas":4,"vagasCobertas":4,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2026,"anoReforma":null,"condominio":null,"iptu":450,"precoM2":7020.2,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Desocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Marcio","celular":"(11) 94022-9631","creci":null}}