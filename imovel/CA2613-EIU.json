rrasqueira,\r\nLocalizada na charmosa Vila Buenos Aires, esta casa oferece um espaço ideal para quem busca conforto e praticidades. Com 3 quartos, sendo 1 deles uma suíte, o imóvel é perfeito para acomodar famílias de diferentes tamanhos. A casa conta com 3 vagas de garagem, garantindo praticidades para quem possui mais de um veículo ou recebe visitas frequentemente. Além disso, o condomínio dispõe de uma churrasqueira, proporcionando momentos de lazer e confraternização com amigos e familiares. Outro destaque é que o imóvel permite animais de estimação, tornando-o uma excelente escolha para quem não abre mão da companhia dos seus pets. Se você procura um lar que combine funcionalidades e uma localização tranquila, esta casa na Vila Buenos Aires pode ser a escolha certa.\r\n\r\nDescrição do proprietário\r\nArejado, vista livre, excelente iluminação, a 200 metros da avenida São Miguel, perto do parque Tiquatira e do mercado Assai, terreno com 240 m².","comodidades":["Churrasqueira","Sacada / Varanda","Quintal","Lavabo","Área de Serviço","Água","Esgoto","Rua Asfaltada","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Casa Residencial","finalidade":"residencial","areaUtil":160,"areaTotal":240,"quartos":3,"suites":1,"banheiros":2,"salas":1,"vagas":3,"vagasCobertas":3,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2000,"anoReforma":null,"condominio":null,"iptu":270,"precoM2":4062.5,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":null,"videoInstitucional":false,"tour":null,"corretor":{"nome":"Camara","celular":"(11) 97709-4147","creci":null}}