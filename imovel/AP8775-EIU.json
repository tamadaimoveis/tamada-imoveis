 região de fácil acesso às principais vias do litoral norte paulista. \r\n\r\nO entorno conta com infraestrutura completa, com supermercados, farmácias, padarias, restaurantes e escolas próximas e fácil acesso para deslocamento pela cidade e para as demais praias da região.\r\n\r\nO Condomínio oferece estrutura de lazer completa com piscina, área de churrasqueira, salão de festas, ducha e bicicletário. Garante também segurança e comodidade com alarme, cerca elétrica, portão eletrônico com portaria remota e interfone.\r\n\r\nReserve já o seu !!  IPTU ainda a definir.\r\n\r\nAgende uma visita com um dos nossos corretores !!","comodidades":["Piscina","Sauna","Quadra Poliesportiva","Sacada / Varanda","Varanda Gourmet","Lavabo","Área de Serviço","Copa","Depósito","Solário","Vestiário","Portão Eletrônico","Aceita Pet","Garagem Coberta","Cozinha com Área de Serviço"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":[],"tags":[],"ficha":{"subTipo":"Apartamento Residencial","finalidade":"residencial","areaUtil":143,"areaTotal":null,"quartos":3,"suites":3,"banheiros":3,"salas":1,"vagas":2,"vagasCobertas":2,"vagasDescobertas":null,"tipoVaga":null,"andar":1,"andaresPredio":18,"elevadores":null,"peDireito":null,"anoConstrucao":2026,"anoReforma":null,"condominio":650,"iptu":0.01,"precoM2":12587.41,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":null,"locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"André","celular":"(11) 94746-4495","creci":null}}