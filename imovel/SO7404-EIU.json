4x471.jpg","https://cdn.sanity.io/images/v3whr4as/production/c08526384bf1d3daa43e3ad69483f3acb9fc17a3-1024x471.jpg","https://cdn.sanity.io/images/v3whr4as/production/8abb6e13dd0a2d3e91906f3a6d7e85130a847750-1024x471.jpg","https://cdn.sanity.io/images/v3whr4as/production/3305c09f454447860b6b3e32e67e2cb03f5e76b2-1024x471.jpg"],"descricao":"Excelente Oportunidade para Investidor  Imóvel com Renda!\r\n\r\nSobrado com 308 m² de área construída, localizado na Vila Paranaguá  São Paulo/SP, em rua tranquila e sem saída, oferecendo segurança, privacidade e ótima valorização.\r\n\r\nImóvel atualmente alugado, ideal para quem busca investimento com retorno imediato.\r\n\r\nDistribuição do Imóvel:\r\n\r\nPavimento Inferior:\r\nSala ampla com dois ambientes;\r\nCozinha espaçosa com despensa;\r\nRefeitório;\r\nBrinquedoteca;\r\nÁrea de serviço com pia;\r\nLavanderia;\r\nBanheiro adaptado;\r\nSala auxiliar/almoxarifado.\r\n\r\nPavimento Superior:\r\n5 dormitórios, sendo 2 utilizados como escritório;\r\nUm dos quartos com sacada;\r\nTerraço entre dois dormitórios;\r\n3 banheiros.\r\n\r\nDiferenciais\r\n3 vagas de garagem;\r\nLindo jardim, trazendo conforto e bem-estar;\r\nPlanta versátil, ideal para uso residencial ou institucional\r\nImóvel bem conservado.\r\n\r\nLocalização\r\nPróximo a comércios, serviços e conveniências, com fácil acesso às principais vias da região, garantindo mobilidade e praticidade.\r\n\r\nExcelente opção para investidores que buscam segurança, renda recorrente e potencial de valorização.\r\n\r\nEntre em contato e fale com nossa equipe de corretores especializados, pronta para oferecer um atendimento completo e personalizado.","comodidades":["Sacada / Varanda","Terraço","Quintal","Área de Serviço","Despensa","Escritório","Dormitório Reversível","Portão Eletrônico","TV a Cabo","Aceita Pet","Água","Esgoto","Energia Elétrica","Rua Asfaltada","Cozinha com Área de Serviço"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Sobrado Residencial","finalidade":"residencial","areaUtil":308,"areaTotal":232,"quartos":5,"suites":null,"banheiros":3,"salas":1,"vagas":3,"vagasCobertas":null,"vagasDescobertas":3,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2008,"anoReforma":2020,"condominio":null,"iptu":376.84,"precoM2":2597.4,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":true,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}