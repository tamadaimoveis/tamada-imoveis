m vaga de garagem.\r\n\r\nIptu isento / todo reformado / porcelanato.\r\n\r\nCom apenas 3 anos, o Residencial Único Jacu Pêssego foi construído em meio ao aumento da busca por praticidade e em uma região que facilita o dia a dia.\r\n\r\nContando com portaria 24 horas, elevador, academia, quadra esportiva, salão de festas, playground, salão de jogos e brinquedoteca, o Residencial Único Jacu Pêssego é preparado para atender às necessidades dos moradores que buscam lazer e conforto em um só lugar.\r\n\r\nA proximidade com Colégio AFAM, Universidade Cruzeiro do Sul, Ambulatório Descentralizado de São Miguel Paulista, Praça José Osório Ferraz, Escola Estadual Tide Setúbal e Escola Pedro Teixeira acrescenta praticidade e comodidade na rotina dos que residem no local.\r\n\r\nAceita financiamento !\r\n\r\nAgende uma visita com um de nossos corretores !!","comodidades":["Churrasqueira","Quadra Poliesportiva","Área de Serviço","Interfone","Portão Eletrônico","Aceita Pet","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Apartamento Residencial","finalidade":"residencial","areaUtil":35,"areaTotal":null,"quartos":2,"suites":null,"banheiros":1,"salas":1,"vagas":null,"vagasCobertas":null,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":10,"elevadores":null,"peDireito":null,"anoConstrucao":2018,"anoReforma":null,"condominio":400,"iptu":null,"precoM2":6685.71,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":"Desocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/VTeOzy8J-hk","videoInstitucional":true,"tour":null,"corretor":{"nome":"Silvio","celular":"(11) 98872-1820","creci":null}}