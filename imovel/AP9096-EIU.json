nda gourmet.\r\n\r\nCozinha planejada, lavanderia independente, lavabo e 3 vagas de garagem.\r\n\r\n*Todos os ambientes com móveis planejados / Fino acabamento, tudo de primeira linha.\r\n\r\nElevadores:\r\n* Elevador social atendendo apenas 2 apartamentos.\r\n* Elevador de serviço atendendo 4 apartamentos.\r\n\r\nApartamento alto, bem localizado, com estrutura completa para quem busca conforto, segurança e lazer em um único lugar.\r\n\r\nContando com portaria 24 horas, elevador, academia, piscina, quadra esportiva, salão de festas, gás encanado, churrasqueira, playground, sauna e brinquedoteca, o Condomínio Solares Vila Maria é preparado para atender às necessidades dos moradores que buscam lazer e conforto em um só lugar.\r\n\r\nA proximidade com Hospital e Maternidade Nossa Senhora do Rosário, Escola Sion, CEI, Uninove, Escola Professor A. O. de Laerl e Colégio São Francisco de Paula acrescenta praticidade e comodidade na rotina dos que residem no local.\r\n\r\nAceita financiamento !\r\n\r\nAgende uma visita com um de nossos corretores !!.","comodidades":["Piscina","Churrasqueira","Quadra Poliesportiva","Sacada / Varanda","Área de Serviço","Despensa","Escritório","Closet","Interfone","Zelador","Aceita Pet","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato","Granito"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Apartamento Residencial","finalidade":"residencial","areaUtil":130,"areaTotal":null,"quartos":3,"suites":3,"banheiros":4,"salas":1,"vagas":3,"vagasCobertas":3,"vagasDescobertas":null,"tipoVaga":null,"andar":24,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2000,"anoReforma":null,"condominio":1585,"iptu":558.43,"precoM2":13846.15,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":null,"locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome