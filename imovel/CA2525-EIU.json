l e bem arejada.\r\n\r\nEspaço gourmet com churrasqueira. Escada com acesso privativo para casa . \r\n\r\nPiso inferior abaixo do nível da rua com dois escritórios e vaga para 3 carros, sendo 2 cobertas.  \r\n\r\nSótão amplo, pé direito alto, com acesso por escada bombeiro.\r\n\r\nAcesso rápido ao metrô Patriarca. \r\n\r\nCercado por comércios como padaria, farmácia, loja de roupas, feira, mercados e açougue, assim como vários tipos de serviços.\r\n\r\nAgende visita com um de nossos corretores!","comodidades":["Churrasqueira","Lavabo","Closet","Jardim de Inverno","Interfone","Portão Eletrônico","TV a Cabo","Água","Esgoto","Energia Elétrica","Rua Asfaltada","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato","Cerâmica"],"garantias":["Seguro Fiança"],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Casa Residencial","finalidade":"residencial","areaUtil":135,"areaTotal":256,"quartos":3,"suites":1,"banheiros":2,"salas":2,"vagas":3,"vagasCobertas":1,"vagasDescobertas":2,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2010,"anoReforma":2020,"condominio":null,"iptu":57.23,"precoM2":7037.04,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":null,"videoInstitucional":false,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}