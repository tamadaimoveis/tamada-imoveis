 visita!","comodidades":["Churrasqueira","Sacada / Varanda","Varanda Gourmet","Quintal","Lavabo","Garagem Coberta","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Sobrado Residencial","finalidade":"residencial","areaUtil":220,"areaTotal":80,"quartos":3,"suites":3,"banheiros":5,"salas":2,"vagas":4,"vagasCobertas":4,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2024,"anoReforma":null,"condominio":null,"iptu":2500,"precoM2":4500,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Novo","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}