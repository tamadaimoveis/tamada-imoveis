uintal","Lavabo","Interfone","Portão Eletrônico","Alarme","Aceita Pet","Água","Garagem Coberta","Armários Planejados"],"acabamentos":[],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Casa Residencial","finalidade":"residencial","areaUtil":200,"areaTotal":150,"quartos":3,"suites":3,"banheiros":3,"salas":2,"vagas":4,"vagasCobertas":2,"vagasDescobertas":2,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2000,"anoReforma":2020,"condominio":null,"iptu":300,"precoM2":5900,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":null,"locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":null,"videoInstitucional":false,"tour":null,"corretor":{"nome":"Sandro","celular":"(11) 96204-1814","creci":null}}