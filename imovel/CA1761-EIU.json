ormações e agende uma visita!","comodidades":["Churrasqueira","Quintal","Área de Serviço","Água","Esgoto","Energia Elétrica","Garagem Coberta"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":[],"tags":[],"ficha":{"subTipo":"Casa Residencial","finalidade":"residencial","areaUtil":260,"areaTotal":432,"quartos":5,"suites":1,"banheiros":3,"salas":2,"vagas":1,"vagasCobertas":1,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":1980,"anoReforma":null,"condominio":null,"iptu":null,"precoM2":4192.31,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":true,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/VTeOzy8J-hk","videoInstitucional":true,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}