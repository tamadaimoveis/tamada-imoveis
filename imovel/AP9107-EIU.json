ados;\r\n* Banheiro com armário e box de vidro;\r\n* Mesa dobrável fixada na parede, otimizando o espaço.\r\n* Fechadura eletrônico\r\n\r\nO condomínio oferece portaria e segurança, proporcionando mais tranquilidade aos moradores. Conta com uma academia, lavanderia e um salão de festas equipado.\r\n\r\nLocalização privilegiada:\r\n\r\n* Aproximadamente 500 metros da Estação PatriarcaVila Ré do Metrô;\r\n* Ponto de ônibus em frente ao condomínio;\r\n* Próximo a escolas, mercados, UBS e diversos comércios e serviços da região.\r\n\r\nIdeal para quem deseja morar com fácil acesso ao transporte público e toda a infraestrutura do bairro Patriarca.\r\n\r\nEntre em contato para mais informações e agende uma visita com um de nossos corretores!","comodidades":["Sacada / Varanda","Área de Serviço","Interfone","Portão Eletrônico","Zelador","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato"],"garantias":["Seguro Fiança"],"pagamento":[],"tags":["Alto Padrão"],"ficha":{"subTipo":"Apartamento Residencial","finalidade":"residencial","areaUtil":25,"areaTotal":25,"quartos":1,"suites":null,"banheiros":1,"salas":1,"vagas":null,"vagasCobertas":null,"vagasDescobertas":null,"tipoVaga":null,"andar":2,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2022,"anoReforma":null,"condominio":270,"iptu":null,"precoM2":null,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Desocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Leonor Martins D Silva","celular":"(11) 94345-2831","creci":null}}