lo, Assai Atacadista, Academia Smart Fit, etc...\r\n\r\nFácil acesso ao transporte publico e as avenidas principais do Bairro, Av. Amador Bueno da Veiga e Av. São Miguel.\r\n\r\nAceita financiamento !\r\n\r\nAgende uma visita com um de nossos corretores !!","comodidades":["Churrasqueira","Sacada / Varanda","Lavabo","Portão Eletrônico","Aceita Pet","Água","Esgoto","Energia Elétrica","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Casa Residencial","finalidade":"residencial","areaUtil":91,"areaTotal":105,"quartos":3,"suites":1,"banheiros":2,"salas":1,"vagas":3,"vagasCobertas":2,"vagasDescobertas":1,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2019,"anoReforma":null,"condominio":null,"iptu":null,"precoM2":8241.76,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Desocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Solange","celular":"(11) 98415-6556","creci":null}}