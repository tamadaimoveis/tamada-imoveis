tários. Condomínio conta com acesso por duas entradas. Sobre a localização fica 7 minutos a pé do metrô Vila Matilde e 10 minutos metrô Penha (obras avançadas da futura interligação com a linha Verde), acesso fácil à Radial e Marginal Leste. Em frente ao Escola Estadual Rita Julia de Oliveira e ao lado da Creche-CEI Mirandinha, e próximos a outras escolas particulares. Com feira-livre as terças, próximo ao Mercado Matsui, farmácia e outros comércios na rua.","comodidades":["Churrasqueira","Área de Serviço"],"acabamentos":[],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Sobrado Residencial","finalidade":"residencial","areaUtil":52,"areaTotal":null,"quartos":1,"suites":null,"banheiros":1,"salas":1,"vagas":null,"vagasCobertas":null,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2010,"anoReforma":null,"condominio":229.89,"iptu":null,"precoM2":5192.31,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":"Desocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}