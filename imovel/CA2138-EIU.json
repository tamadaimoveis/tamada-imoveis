alizado no bairro Cidade A. E. Carvalho.\r\nTerreno 300m² - 10 x30 e possui 250m² de área construída.\r\nCasa 1\r\nA casa da frente é térrea com 04 quartos, sendo 01 externo, sala, cozinha, banheiro e lavanderia. Com 03 vagas de garagem coberta e com portão eletrônico.\r\nPonto comercial\r\nSalão na frente, com porta de aço e mezanino.\r\nCasa 2\r\nCasa nos fundos é composta por 2 andares. Piso térreo com cozinha, lavanderia, sala, banheiro e 1 quarto. Piso superior com ampla área de churrasqueira.","comodidades":["Portão Eletrônico","Aceita Pet","Água","Esgoto","Energia Elétrica","Garagem Coberta"],"acabamentos":[],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Casa Residencial","finalidade":"residencial","areaUtil":250,"areaTotal":300,"quartos":4,"suites":null,"banheiros":1,"salas":2,"vagas":3,"vagasCobertas":3,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":1995,"anoReforma":2005,"condominio":null,"iptu":140,"precoM2":2540,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":null,"locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Sandro","celular":"(11) 96204-1814","creci":null}}