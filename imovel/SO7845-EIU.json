ão tranquila, mas cercada de conveniências.\r\n\r\nTransporte: Fácil acesso às estações de Metrô Tucuruvi e Parada Inglesa (Linha 1-Azul) e diversas linhas de ônibus na Av. Guapira.\r\n\r\nComércio e Serviços: A poucos minutos do Hipermercado Bergamini e do Shopping Metrô Tucuruvi. A região conta com farmácias, padarias, escolas e o Hospital São Luiz Gonzaga nas proximidades.\r\n\r\nAcesso: Saída rápida para as principais vias da região, como a Avenida Guapira, Avenida Luís Stamatis e Rodovia Fernão Dias.\r\n\r\nNão perca essa chance de conquistar seu novo lar.\r\n\r\nAgende agora mesmo sua visita com um de nossos corretores!","comodidades":["Churrasqueira","Lavabo","Área de Serviço","TV a Cabo","Aceita Pet","Água","Esgoto","Energia Elétrica","Rua Asfaltada","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Sobrado Residencial","finalidade":"residencial","areaUtil":117,"areaTotal":118,"quartos":3,"suites":1,"banheiros":2,"salas":1,"vagas":2,"vagasCobertas":2,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":1,"elevadores":null,"peDireito":null,"anoConstrucao":1995,"anoReforma":null,"condominio":null,"iptu":null,"precoM2":5384.62,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":null,"videoInstitucional":false,"tour":null,"corretor":{"nome":"Deise","celular":"(11) 99345-5259","creci":null}}