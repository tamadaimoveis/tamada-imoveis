 e transporte público próximos.\r\n\r\n Composição do imóvel:\r\n\r\nCasa 1: 2 dormitórios, sala, copa, cozinha, banheiro e lavanderia.\r\n\r\nCasa 2: sala, cozinha e banheiro.\r\n\r\nCasa 3: 1 dormitório, sala, cozinha, banheiro, quintal e lavanderia.\r\n\r\nGaragem: 1 vaga coberta.\r\n\r\n Destaques:\r\nTerreno amplo e bem aproveitado;\r\nIdeal para renda com locações (três casas independentes);\r\nÓtima localização, próxima a comércios e transporte;\r\nBairro familiar e valorizado na Zona Leste.\r\n\r\nAgende sua visita e venha conhecer!","comodidades":["Quintal"],"acabamentos":[],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Casa Residencial","finalidade":"residencial","areaUtil":302,"areaTotal":null,"quartos":3,"suites":null,"banheiros":3,"salas":3,"vagas":1,"vagasCobertas":null,"vagasDescobertas":1,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":1975,"anoReforma":2010,"condominio":null,"iptu":3630,"precoM2":2284.77,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":null,"locado":true,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}