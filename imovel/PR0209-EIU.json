","Energia Elétrica","Rua Asfaltada","Garagem Coberta"],"acabamentos":["Porcelanato","Granito","Taco de Madeira"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Prédio Comercial","finalidade":"comercial","areaUtil":448,"areaTotal":280,"quartos":null,"suites":null,"banheiros":6,"salas":null,"vagas":4,"vagasCobertas":4,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":1980,"anoReforma":null,"condominio":null,"iptu":1036,"precoM2":5915.18,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Makiya","celular":"(11) 98539-3772","creci":null}}