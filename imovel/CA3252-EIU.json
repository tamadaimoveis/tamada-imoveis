goto","Energia Elétrica","Rua Asfaltada","Garagem Coberta","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato","Granito"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Casa Residencial","finalidade":"residencial","areaUtil":141,"areaTotal":null,"quartos":4,"suites":1,"banheiros":2,"salas":1,"vagas":2,"vagasCobertas":1,"vagasDescobertas":1,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2026,"anoReforma":null,"condominio":null,"iptu":0.01,"precoM2":10283.69,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Desocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Claudio Domingues","celular":"(11) 97795-5441","creci":null}}