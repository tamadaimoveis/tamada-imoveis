er. A garagem coberta acomoda 2 veículos com segurança e comodidade.\r\n\r\nDestaques do imóvel:\r\n\r\n3 dormitórios (1 suíte)\r\n\r\n2 banheiros\r\n\r\n2 salas amplas\r\n\r\nCozinha com armários planejados\r\n\r\nChurrasqueira\r\n\r\n2 vagas cobertas\r\n\r\nArmários em 2 quartos\r\n\r\nLocalização privilegiada:\r\n\r\nColégio Monte Virgem e Colégio Fereguete a menos de 10 minutos a pé\r\n\r\nAcademia Smart Fit a menos de 10 minutos a pé\r\n\r\nPadaria a apenas 5 minutos\r\n\r\nFeira livre aos sábados na rua ao lado\r\n\r\nFácil acesso a supermercados, farmácias, açougues e transporte público\r\n\r\nImóvel pronto para morar. Agende sua visita e venha conhecer!","comodidades":["Churrasqueira","Área de Serviço","Copa","Mobiliado","Água","Energia Elétrica","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":[],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Sobrado Residencial","finalidade":"residencial","areaUtil":186,"areaTotal":null,"quartos":3,"suites":1,"banheiros":2,"salas":2,"vagas":2,"vagasCobertas":2,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":1990,"anoReforma":null,"condominio":null,"iptu":null,"precoM2":6989.25,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":null,"locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Victor","celular":"(11) 98500-1913","creci":null}}