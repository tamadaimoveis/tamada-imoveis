uídos, a propriedade inclui uma varanda e um quintal, ideais para momentos de lazer e descanso. Além disso, conta com 1 vaga de garagem, proporcionando maior conveniência para os moradores. A localização é um dos destaques, com acesso próximo a áreas verdes como a Praça José Osório Ferraz e o Parque Linear Dario Costa, ideais para quem aprecia atividades ao ar livre e contato com a natureza. Essa casa é uma excelente escolha para quem busca um imóvel funcional em uma região com infraestrutura completa.","comodidades":["Sacada / Varanda","Quintal","Área de Serviço","Portão Eletrônico","Água","Esgoto","Energia Elétrica","Rua Asfaltada","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":[],"ficha":{"subTipo":"Casa Residencial","finalidade":"residencial","areaUtil":72,"areaTotal":80,"quartos":2,"suites":null,"banheiros":2,"salas":1,"vagas":1,"vagasCobertas":null,"vagasDescobertas":1,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2016,"anoReforma":null,"condominio":null,"iptu":null,"precoM2":6805.56,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":null,"videoInstitucional":false,"tour":null,"corretor":{"nome":"Camara","celular":"(11) 97709-4147","creci":null}}