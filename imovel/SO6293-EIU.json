rounds. \r\nO condomínio conta, ainda, com linha de ônibus interna e exclusiva, além de capela ativa, onde são celebradas missas e até casamentos.\r\nO acesso a praia é exclusivo, através de passarela própria e o controle de acesso é rígido e controlado por cadastro facial. O controle da segurança se dá através de quase 500 câmeras, além de patrulhamento por seguranças feito através de carros e motos.\r\nA casa fica num condomínio fechado de alto padrão na praia de Boraceia em Bertioga-SP à 5 Km. da Praia\r\n   \r\nProprietária estuda proposta e permuta por imovel em Mogi das Cruzes ou em outros lugares","comodidades":["Piscina","Churrasqueira","Hidromassagem","Quadra Poliesportiva","Campo de Futebol","Varanda Gourmet","Quintal","Lavabo","Área de Serviço","Copa","Despensa","Depósito","Dormitório Reversível","WC de Empregada","Vestiário","Aceita Pet","Água","Esgoto","Energia Elétrica","Condomínio Fechado","Garagem Coberta","Armários Planejados"],"acabamentos":["Porcelanato","Cerâmica"],"garantias":[],"pagamento":["Financiamento bancário","Permuta"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Sobrado Residencial","finalidade":"residencial","areaUtil":400,"areaTotal":588,"quartos":5,"suites":4,"banheiros":6,"salas":2,"vagas":10,"vagasCobertas":6,"vagasDescobertas":4,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2000,"anoReforma":null,"condominio":650,"iptu":null,"precoM2":4587.5,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/VTeOzy8J-hk","videoInstitucional":true,"tour":null,"corretor":{"nome":"Makiya","celular":"(11) 98539-3772","creci":null}}