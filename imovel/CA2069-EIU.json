rocurando, entre em contato com a Tamada Imóveis. \r\n\r\nCom uma equipe preparada para oferecer o melhor atendimento e todo o suporte necessário, garantimos uma experiência de compra segura e tranquila. \r\n\r\nA Tamada Imóveis é sinônimo de segurança, conforto e confiabilidade em todas as etapas de seu negócio.","comodidades":["Sacada / Varanda","Quintal","Interfone","Portão Eletrônico","Aceita Pet","Água","Esgoto","Energia Elétrica","Rua Asfaltada","Garagem Coberta","Cozinha com Área de Serviço"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Casa Residencial","finalidade":"residencial","areaUtil":180,"areaTotal":320,"quartos":3,"suites":null,"banheiros":2,"salas":1,"vagas":2,"vagasCobertas":2,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":1980,"anoReforma":null,"condominio":null,"iptu":945.5,"precoM2":12944.44,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":"Desocupado","locado":null,"exclusividade":false,"zoneamento":"ZM","obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}