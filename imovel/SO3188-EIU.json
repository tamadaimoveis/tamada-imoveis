 quartos (sendo 1 suíte), sala, cozinha, 2 banheiros (contam com box American Box), lavanderia, garagem com portão automático para 2 carros. \r\n\r\nNa parte superior há churrasqueira e amplo espaço para lazer. Também tem o jardim de inverno, espaço com cobertura retrátil e porta balcão.\r\n\r\nLocalização privilegiada, próximo ao metrô Penha e Shopping (600 mts), escola púbica e particular, ETEC, Faculdade, Comércio, Hospital da Penha e Posto de Saúde. Terá acesso à futura estação Penha de França também! \r\n\r\nPara quem busca a tranquilidade do bairro, com espaço e perto de tudo, é imperdível. Isento de IPTU!\r\n\r\nAceita financiamento !\r\n\r\nAgende uma visita com um dos nossos corretores !!","comodidades":["Churrasqueira","Quintal","Lavabo","Jardim de Inverno","Interfone","Portão Eletrônico","Alarme","Água","Esgoto","Energia Elétrica","Rua Asfaltada","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato","Cerâmica","Granito"],"garantias":[],"pagamento":["Financiamento bancário","Permuta"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Sobrado Residencial","finalidade":"residencial","areaUtil":120,"areaTotal":null,"quartos":3,"suites":1,"banheiros":1,"salas":2,"vagas":2,"vagasCobertas":2,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2000,"anoReforma":null,"condominio":null,"iptu":null,"precoM2":7500,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":true,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Victor","celular":"(11) 98500-1913","creci":null}}