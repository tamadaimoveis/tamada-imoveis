DESCRIÇÃO:\r\n\r\n- 180 M2, terreno 05x25m;\r\n\r\n- O2 quartos com molduras de gesso nas paredes, pinturas em látex e piso em carpete de madeira;\r\n\r\n- Sala de estar, piso em carpete de madeira, molduras de gesso nas paredes e pintura em látex;\r\n\r\n- Cozinha toda azulejada, molduras de gesso nas paredes, mesa de granito e piso em porcelanato;\r\n\r\n- Banheiros decorados, cuba em porcelana e box de vidro;\r\n\r\n- Varanda gourmet nos fundos com churrasqueira, pia e banheiro, toda decorada com revestimento especial;\r\n\r\n- Lavanderia coberta;\r\n\r\n- Garagem coberta para dois carros grandes ou vans;\r\n\r\n- Portão automático;\r\n\r\nEste imóvel está dentro do que você está procurando?\r\n\r\nEntre em contato para obter o melhor atendimento e todo o suporte que você precisa para realizar seu sonho. \r\n\r\nEsta propriedade pode ser financiada.\r\n\r\nVenha para a Tamada imóveis, segurança, conforto e confiabilidade!","comodidades":["Churrasqueira","Quintal","Lavabo","Pé-direito Duplo","Interfone","Portão Eletrônico","Aceita Pet","Água","Esgoto","Energia Elétrica","Rua Asfaltada","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato","Cerâmica","Carpete"],"garantias":[],"pagamento":["Financiamento bancário"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Sobrado Residencial","finalidade":"residencial","areaUtil":250,"areaTotal":125,"quartos":2,"suites":null,"banheiros":2,"salas":1,"vagas":2,"vagasCobertas":2,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":3,"elevadores":null,"peDireito":null,"anoConstrucao":2011,"anoReforma":null,"condominio":null,"iptu":null,"precoM2":2280,"precoAVista":null,"aceitaNegociacao":null,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":"ZM","obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}