ientes, cozinha ampla e arejada trazendo mais claridade com luz natural, área de serviço gourmet com  churrasqueira para curtir com a família aos finais de semana.\r\n02 vagas de garagem.\r\nAceita permuta em imóvel de menor valor, apartamento ou sobrado em condomínio.\r\nGrande variedade de comércios locais, escolas, hospitais, petshop e academias.\r\nLocalização com fácil acesso as principais vias AV São Miguel e Marginal Tietê.\r\nDocumentação em ordem para financiamento e aceita FGTS.\r\nVenha nos visitar \r\nContamos ainda com o Departamento Jurídico próprio e especializado em Direito Imobiliário.\r\nVocê e sua família  sentirá segurança para realizar o seu negócio com confiança, credibilidade e agilidade nos processos.\r\n\r\nAceita financiamento!\r\n\r\nAgende uma visita com um de nossos corretores !!","comodidades":["Churrasqueira","Sacada / Varanda","Quintal","Lavabo","Interfone","Portão Eletrônico","TV a Cabo","Aceita Pet","Água","Esgoto","Energia Elétrica","Rua Asfaltada","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato","Cerâmica","Granito"],"garantias":[],"pagamento":["Financiamento bancário","Permuta"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Casa Residencial","finalidade":"residencial","areaUtil":110,"areaTotal":102,"quartos":3,"suites":1,"banheiros":1,"salas":1,"vagas":2,"vagasCobertas":1,"vagasDescobertas":1,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":2000,"anoReforma":null,"condominio":null,"iptu":null,"precoM2":5136.36,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"João","celular":"(11) 93219-8384","creci":null}}