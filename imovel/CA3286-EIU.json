m Sala e Cozinha Americana no conceito Integrado, Quarto e Banheiro.\r\n\r\nFino acabamento, tudo de primeira linha.\r\n\r\nImóvel perfeito para famílias grandes, quem gosta de receber amigos e procura conforto com muito espaço.\r\n\r\nExcelente oportunidade para quem busca espaço, conforto e lazer em uma das regiões mais valorizadas da Zona Leste!\r\n\r\nÓtima localização no Engenheiro Goulart, próximo a estação da CPTM, comércios, escolas, mercados, transporte público e fácil acesso às principais vias da região.\r\n\r\nAceita financiamento !\r\n\r\nAgende uma visita com um de nossos corretores !!","comodidades":["Piscina","Churrasqueira","Hidromassagem","Sacada / Varanda","Quintal","Lavabo","Área de Serviço","Escritório","Closet","Ar Condicionado","Interfone","Portão Eletrônico","TV a Cabo","Mobiliado","Aceita Pet","Água","Esgoto","Energia Elétrica","Rua Asfaltada","Garagem Coberta","Armários Planejados","Cozinha com Área de Serviço"],"acabamentos":["Porcelanato","Cerâmica"],"garantias":[],"pagamento":["Financiamento bancário","Permuta"],"tags":[],"ficha":{"subTipo":"Casa Residencial","finalidade":"residencial","areaUtil":294,"areaTotal":300,"quartos":3,"suites":1,"banheiros":4,"salas":1,"vagas":2,"vagasCobertas":2,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":1999,"anoReforma":null,"condominio":null,"iptu":400,"precoM2":7459.4,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Claudio Domingues","celular":"(11) 97795-5441","creci":null}}