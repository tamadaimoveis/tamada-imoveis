im São Carlos;\r\n- EMEI General Miguel Costa;\r\n- EE Marinha do Brasil;\r\n- Supermercados;\r\n- Feira livre;\r\n- Restaurantes e lanchonetes;\r\n\r\nImóvel não da Financiamento bancário, compra somente a vista!","comodidades":["Área de Serviço","Portão Eletrônico","Aceita Pet","Água","Esgoto","Energia Elétrica","Rua Asfaltada","Garagem Coberta","Cozinha com Área de Serviço"],"acabamentos":["Cerâmica"],"garantias":[],"pagamento":["Permuta"],"tags":["Alto Padrão"],"ficha":{"subTipo":"Sobrado Residencial","finalidade":"residencial","areaUtil":100,"areaTotal":null,"quartos":2,"suites":null,"banheiros":2,"salas":1,"vagas":1,"vagasCobertas":1,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":null,"elevadores":null,"peDireito":null,"anoConstrucao":1973,"anoReforma":null,"condominio":null,"iptu":null,"precoM2":2800,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Ocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Tamada Imóveis","celular":"(11) 2682-2320","creci":null}}