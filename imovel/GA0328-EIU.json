al = 450m².\r\n\r\nLocalização privilegiada em um dos melhores bairros da zona leste. Ótima infraestrutura, transporte para várias regiões, perto do Metrô Vila Matilde, serviços, comércios, tudo perto.....\r\n\r\nGrande visibilidade e grande fluxo de veículos, um galpão completo e bem localizado.\r\n\r\nAgende uma visita com um dos nossos corretores !!","comodidades":["Água","Esgoto","Energia Elétrica","Rua Asfaltada","Garagem Coberta","Cozinha com Área de Serviço"],"acabamentos":[],"garantias":[],"pagamento":["Permuta"],"tags":[],"ficha":{"subTipo":"Galpão Comercial","finalidade":"comercial","areaUtil":562,"areaTotal":450,"quartos":null,"suites":null,"banheiros":3,"salas":7,"vagas":15,"vagasCobertas":15,"vagasDescobertas":null,"tipoVaga":null,"andar":null,"andaresPredio":2,"elevadores":null,"peDireito":null,"anoConstrucao":1980,"anoReforma":null,"condominio":null,"iptu":1200,"precoM2":4448.4,"precoAVista":null,"aceitaNegociacao":true,"ocupacao":"Desocupado","locado":null,"exclusividade":false,"zoneamento":null,"obra":null},"video":"https://youtu.be/OC9inC5kT_w","videoInstitucional":true,"tour":null,"corretor":{"nome":"Maria Helena","celular":"(11) 97111-9161","creci":null}}